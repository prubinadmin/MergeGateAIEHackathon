# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL: the second, independent spec-test writer (Gemini 4 Argon). Set GEMINI_API_KEY to enable it; a PR must then get past Muse's tests and Gemini's.
GEMINI_MODEL=gemini-4-argon

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Meta Model API (Muse Spark)
MUSE_API_KEY=
MUSE_BASE_URL=
# muse-wonder-1.0 measured faster than muse-spark-1.3 on the test-writing prompt (23 s vs 36 s, 9 vs 7 tests); empty = muse-spark-1.3
MUSE_MODEL=muse-wonder-1.0

# SubQ Snap 1.1 (merge_gate/subq.py): picks who to page and how urgently. Without it: blame ranking only.
SUBQ_API_KEY=

# MongoDB Atlas
MONGODB_URI=

# iMessage (TAAZ): owner email -> phone, JSON, demo phones only
OWNER_PHONES={}

# Agentic paging: `serve` texts the code owner on every verdict (/api/verify and /api/run). Set 0 to disable automatic texting.
MERGE_GATE_AUTO_PAGE=1

# Sendblue iMessage (merge_gate/imessage.py). Free plan: shared line + each phone texts it once first.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
# >=16 random chars; webhook URL: https://<public-host>/api/sendblue?token=<this>
SENDBLUE_WEBHOOK_SECRET=

# Fetch.ai agent (agents/merge_gate_agent.py): long random phrase, it IS the agent identity/address. Keep secret.
MERGE_GATE_AGENT_SEED=
# Optional: MERGE_GATE_AGENT_PORT=8001; MERGE_GATE_AGENT_LLM=0 skips the TestWriter/Sandbox agents (default: on when MUSE_API_KEY is set)
# Optional: ASI:One intent parsing, consulted only when the keyword parser yields "help" (https://asi1.ai API key)
ASI_ONE_API_KEY=
# Chat senders (comma-separated agent1q... addresses) allowed to run TestWriter + Sandbox on a GitHub PR from chat,
# i.e. to execute a third-party repo's code on this machine. Empty = nobody; everyone else gets Rules + OwnerRouter only.
MERGE_GATE_CHAT_GITHUB_ALLOW=
